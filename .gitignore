# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Internal tooling
.superpowers/

# Raw financial data — never commit
/sheets/
/transactions/
/data/
*.csv
*.xlsx

# Allow hand-built test fixtures (no real data)
!tests/fixtures/**/*.csv

# dependencies
/node_modules
/node_modules.bak/
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Market-data quote cache
/.cache/
